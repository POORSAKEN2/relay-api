# Copy to .env for local development. Every variable is checked at startup (src/config/env.ts).

# Local PostgreSQL 18 (one-time setup SQL in README.md). Development-only credentials.
DATABASE_URL=postgres://relay:relay@localhost:5432/relay
TEST_DATABASE_URL=postgres://relay:relay@localhost:5432/relay_test

# garified.com in production. With localhost, open the web app at http://desert.localhost:5173
APP_DOMAIN=localhost

# Keys the hash of technician sign-in codes. This value is for development only; production
# sets its own: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SIGN_IN_CODE_SECRET=dev-only-sign-in-code-secret-do-not-use-in-production

PORT=3000
LOG_LEVEL=info

# Leave empty to keep Sentry off locally.
SENTRY_DSN=

# Texting. 'log' sends nothing and prints each text here instead (how you read a sign-in code).
# 'httpsms' sends through the httpSMS app on an Android phone: see README.md.
SMS_PROVIDER=log
HTTPSMS_API_KEY=
HTTPSMS_WEBHOOK_SIGNING_KEY=
# The demo phone's number, E.164 (+639171234567). db:seed makes it the sending number.
SEED_SMS_NUMBER=

# Email (owner and office invites). 'log' sends nothing and prints each email here instead.
# 'smtp' sends through Gmail: see docs/gmail-smtp-setup.md.
EMAIL_PROVIDER=log
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Relay subscription (RevenueCat). The Authorization header value typed when the webhook was
# created in RevenueCat (Integrations, Webhooks): any random string of 16 or more characters.
REVENUECAT_WEBHOOK_AUTH=

# Phone calls (Telnyx): see docs/telnyx-setup.md. Leave empty when not testing calls.
TELNYX_API_KEY=
TELNYX_PUBLIC_KEY=

# AI receptionist's language model. 'off' answers no calls with AI (every call takes a message).
# 'groq' uses Groq's free tier (key from console.groq.com); 'anthropic' uses Claude Haiku 4.5
# (key from platform.claude.com). LLM_TIMEOUT_MS: how long a caller waits before we give up.
LLM_PROVIDER=off
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
LLM_TIMEOUT_MS=8000
# 'true' turns on the receptionist test console (/receptionist-test): pretend calls from the
# browser. Its bookings are real jobs. Keep it off in production except for a demo.
RECEPTIONIST_TEST_CONSOLE=false
